    {
      "name": "Auth",
      "description": "Endpoints de autenticação",
      "item": [
        {
          "name": "Login - Credenciais válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna accessToken', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('accessToken');",
                  "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "});",
                  "",
                  "pm.test('tokenType é Bearer', function () {",
                  "    pm.expect(pm.response.json().tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "pm.test('expiresIn é um número positivo', function () {",
                  "    pm.expect(pm.response.json().expiresIn).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Retorna refreshToken', function () {",
                  "    pm.expect(pm.response.json().refreshToken).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica o usuário e salva o JWT na variável `accessToken` da collection automaticamente via script de teste."
          },
          "response": [
            {
              "name": "200 OK - Token gerado",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"tokenType\": \"Bearer\",\n    \"expiresIn\": 3600,\n    \"refreshToken\": \"base64string...\"\n}"
            }
          ]
        },
